spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

spring.data.redis.host=${REDIS_HOST:127.0.0.1}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.repositories.enabled=false

jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION:1800000}
jwt.refresh-expiration=${JWT_REFRESH_EXPIRATION:1209600000}

app.frontend.origin=${APP_FRONTEND_ORIGIN}
app.frontend.login-url=${APP_FRONTEND_LOGIN_URL:${app.frontend.origin}/auth/login}
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:${app.frontend.origin}}

ai.server.base-url=${AI_SERVER_BASE_URL:http://127.0.0.1:8000}

weather.api.key=${OPENWEATHER_API_KEY:}
holiday.api.service-key=${HOLIDAY_API_SERVICE_KEY:}

spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
